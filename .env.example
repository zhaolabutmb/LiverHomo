# Copy to /home/administrator/.env (outside the repository) and fill in.
# To use a file elsewhere, e.g. on a test workstation, start the app or
# scripts with ENV_FILE=/path/to/.env. Never commit the real file.

# Source data (AnnData)
DATA_PATH=/home/administrator/LiverAtlas/adata_reprocessed_gzip.h5ad
METADATA_PATH=/home/administrator/LiverAtlas/adata_metadata.h5ad
GENE_EXPRESSION_DATA_PATH=/home/administrator/LiverAtlas/adata_gene_expression.h5ad
GENE_VECTOR_CACHE_DIR=/home/administrator/LiverAtlas/.cache/gene_vectors
# Fast copies of the PPI edge lists; defaults to ppi_edges next to GENE_VECTOR_CACHE_DIR
# GRAPH_CACHE_DIR=/home/administrator/LiverAtlas/.cache/ppi_edges

# Result folders
DEG_ROOT=/home/administrator/LiverAtlas/DEG
GRAPH_ROOT=/home/administrator/LiverAtlas/ppi_edgelist
FIGS_ROOT=/home/administrator/LiverAtlas/figs
VOLCANO_ROOT=/home/administrator/LiverAtlas/figs/volcano
EGO_ROOT=/home/administrator/LiverAtlas/figs/ppi_ego
CELL_INTERACTION_ROOT=/home/administrator/LiverAtlas/figs/cell_interactions

# Secrets
OPENAI_API_KEY=

# Contact form email (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
